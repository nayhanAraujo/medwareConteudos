<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MdwConteudos.Api</RootNamespace>
    <UserSecretsId>mdw-conteudos-api-conversor-html</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConversorHtml.Application\ConversorHtml.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.*.local.json;appsettings.Local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Remove="bin-temp/**;bin-check/**;bin-verify*/**;**/*.fdb;**/*.FDB;.env*" />
    <None Update=".env*;**/*.fdb;**/*.FDB" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
